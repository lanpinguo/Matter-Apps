/*
 * nRF54L15 DK — MLX90640 on I2C22
 *
 * Wiring (3.3 V logic):
 *   MLX90640 VIN  -> 3V3
 *   MLX90640 GND  -> GND
 *   MLX90640 SCL  -> P1.12  (same as peripheral_status)
 *   MLX90640 SDA  -> P1.13
 *   Status LED    -> P2.07 (DT led2 / DK_LED3), active-low
 *
 * Default I2C address 0x33 (7-bit). BAB / BAA share the same register map.
 *
 * SPDX-License-Identifier: LicenseRef-Nordic-5-Clause
 */

/ {
	aliases {
		watchdog0 = &wdt31;
		battery-charger = &bq25895;
		status-led = &led2;
	};

	chosen {
		nordic,pm-ext-flash = &mx25r64;
	};
};

/* Status LED on P2.07 — external LED is active-low (same as xbox_central). */
&led2 {
	gpios = <&gpio2 7 GPIO_ACTIVE_LOW>;
	label = "Status LED (P2.07, active-low)";
};

&cpuapp_rram {
	reg = <0x0 DT_SIZE_K(1524)>;
};

&cpuapp_sram {
	reg = <0x20000000 DT_SIZE_K(256)>;
	ranges = <0x0 0x20000000 0x40000>;
};

&uart20 {
	/delete-property/ hw-flow-control;
};

&mx25r64 {
	status = "okay";
};

&wdt31 {
	status = "okay";
};

&pinctrl {
	i2c22_default: i2c22_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 13)>,
				<NRF_PSEL(TWIM_SCL, 1, 12)>;
			bias-pull-up;
		};
	};

	i2c22_sleep: i2c22_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 13)>,
				<NRF_PSEL(TWIM_SCL, 1, 12)>;
			low-power-enable;
			bias-pull-up;
		};
	};
};

&i2c22 {
	status = "okay";
	pinctrl-0 = <&i2c22_default>;
	pinctrl-1 = <&i2c22_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_FAST>;
	zephyr,concat-buf-size = <256>;
	zephyr,flash-buf-max-size = <256>;

	mlx90640: mlx90640@33 {
		compatible = "melexis,mlx90640";
		reg = <0x33>;
	};

	/* BQ25895 fixed 7-bit address 0x6A. INT on P0.02 (same as xbox_central). */
	bq25895: charger@6a {
		compatible = "ti,bq25895";
		reg = <0x6a>;
		int-gpios = <&gpio0 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	};
};
