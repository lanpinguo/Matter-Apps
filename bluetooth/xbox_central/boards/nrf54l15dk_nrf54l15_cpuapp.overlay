/*
 * SPDX-License-Identifier: LicenseRef-Nordic-5-Clause
 *
 * Hub RC link on uart30: TX/RX only (no hardware flow control).
 * BQ25895 power/charge manager on i2c22 (SCL P1.12, SDA P1.13, addr 0x6A).
 * INT -> P0.02 (active-low pulse).
 */

/ {
	aliases {
		battery-charger = &bq25895;
		/* DK LED3 @ P2.07 (DT node led2) — also used as system status LED. */
		status-led = &led2;
	};
};

/*
 * Override DK LED3 (DT: led2, P2.07): external LED is active-low.
 * Board silk LED3 shares this pin; polarity matches the discrete LED.
 */
&led2 {
	gpios = <&gpio2 7 GPIO_ACTIVE_LOW>;
	label = "LED3 / Status LED (P2.07, active-low)";
};

&pinctrl {
	uart30_default: uart30_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 0)>;
		};

		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 1)>;
			bias-pull-up;
		};
	};

	uart30_sleep: uart30_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 0)>,
				<NRF_PSEL(UART_RX, 0, 1)>;
			low-power-enable;
		};
	};

	/*
	 * I2C22 for the BQ25895. P1.12/P1.13 are free on the DK
	 * (console uart20 uses P1.04 TX / P1.05 RX).
	 * Adjust these psels to match your actual BQ25895 wiring.
	 */
	i2c22_default: i2c22_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 12)>,
				<NRF_PSEL(TWIM_SDA, 1, 13)>;
			bias-pull-up;
		};
	};

	i2c22_sleep: i2c22_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 12)>,
				<NRF_PSEL(TWIM_SDA, 1, 13)>;
			low-power-enable;
			bias-pull-up;
		};
	};

	/*
	 * Console uart20: TX/RX only. Board default also muxes RTS/CTS; with a
	 * CP2104 (or any adapter that honors CTS) that blocks host→MCU TX while
	 * MCU→host still works — Enter never reaches the shell.
	 */
	uart20_default: uart20_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 4)>;
		};

		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 5)>;
			bias-pull-up;
		};
	};

	uart20_sleep: uart20_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 4)>,
				<NRF_PSEL(UART_RX, 1, 5)>;
			low-power-enable;
		};
	};
};

&uart30 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart30_default>;
	pinctrl-1 = <&uart30_sleep>;
	pinctrl-names = "default", "sleep";
};

/* Console/shell on uart20 — no HWFC, TX/RX-only pinctrl above */
&uart20 {
	/delete-property/ hw-flow-control;
	pinctrl-0 = <&uart20_default>;
	pinctrl-1 = <&uart20_sleep>;
	pinctrl-names = "default", "sleep";
};

/*
 * Button1 (DK_BTN1 / sw0) on P1.02 for ESB OTA pair hold.
 * P1.02 is NFC1 by default — release via &uicr { nfct-pins-as-gpios; }.
 * Also keeps SW0 off P1.13 (BQ25895 SDA).
 */
&button0 {
	gpios = <&gpio1 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
};

/* Required for P1.02/P1.03 as GPIO on nRF54L (injects NRF_CONFIG_NFCT_PINS_AS_GPIOS). */
&uicr {
	nfct-pins-as-gpios;
};

/*
 * External SPI NOR (DK MX25R64 on spi00). App uses the first 1 MiB as a
 * shared circular log with 4KB sectors (see hub_flash_log.c).
 */
&mx25r64 {
	status = "okay";
};

&i2c22 {
	status = "okay";
	pinctrl-0 = <&i2c22_default>;
	pinctrl-1 = <&i2c22_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	/* BQ25895 has a fixed 7-bit I2C address of 0x6A. INT on P0.02. */
	bq25895: charger@6a {
		compatible = "ti,bq25895";
		reg = <0x6a>;
		int-gpios = <&gpio0 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	};
};
