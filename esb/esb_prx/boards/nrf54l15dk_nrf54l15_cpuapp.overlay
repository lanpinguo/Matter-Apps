/*
 * SPDX-License-Identifier: LicenseRef-Nordic-5-Clause
 *
 * Console / Hub RC link on uart20: TX/RX only (no hardware flow control).
 * RC PWM via PCA9685 on i2c22 (SCL P1.12, SDA P1.13).
 *
 * PCA9685 address: A2=1 A5=1 → 0x40 | BIT(2) | BIT(5) = 0x64.
 * OE (active-low) on P2.10 — driven low in rc_prx_pwm_init to enable outputs.
 * I2C pins match xbox_central BQ25895 (SCL P1.12, SDA P1.13).
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

&pinctrl {
	uart20_default: uart20_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 4)>;
		};

		group2 {
			psels = <NRF_PSEL(UART_RX, 1, 5)>;
			bias-pull-up;
		};
	};

	uart20_sleep: uart20_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 4)>,
				<NRF_PSEL(UART_RX, 1, 5)>;
			low-power-enable;
		};
	};

	i2c22_default: i2c22_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 12)>,
				<NRF_PSEL(TWIM_SDA, 1, 13)>;
			bias-pull-up;
		};
	};

	i2c22_sleep: i2c22_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 1, 12)>,
				<NRF_PSEL(TWIM_SDA, 1, 13)>;
			low-power-enable;
			bias-pull-up;
		};
	};
};

&uart20 {
	current-speed = <115200>;
	pinctrl-0 = <&uart20_default>;
	pinctrl-1 = <&uart20_sleep>;
	pinctrl-names = "default", "sleep";
};

/* SoC PWM no longer used — outputs come from PCA9685. */
&pwm20 {
	status = "disabled";
};

&pwm21 {
	status = "disabled";
};

&i2c22 {
	status = "okay";
	pinctrl-0 = <&i2c22_default>;
	pinctrl-1 = <&i2c22_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_STANDARD>;

	pca9685: pca9685@64 {
		compatible = "nxp,pca9685-pwm";
		reg = <0x64>;
		status = "okay";
		#pwm-cells = <2>;
		/* Init from rc_prx_pwm_init() after DK button pins are remapped. */
		zephyr,deferred-init;
	};
};

/*
 * Pair-clear button on P1.02 (Btn1). DK SW0 defaults to P1.13 (= I2C SDA),
 * so move it here. P1.02 is NFC1 by default — release via &uicr below.
 */
&button0 {
	gpios = <&gpio1 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
};

&uicr {
	nfct-pins-as-gpios;
};

/*
 * Override DK LED3 (DT: led2, P2.07): external status LED is active-low.
 */
&led2 {
	gpios = <&gpio2 7 GPIO_ACTIVE_LOW>;
	label = "LED3 / Status LED (P2.07, active-low)";
};

/ {
	aliases {
		pca9685 = &pca9685;
		/* DK LED3 @ P2.07 — system status (idle slow / CTRL fast / pair rapid). */
		status-led = &led2;
	};

	/*
	 * PCA9685 /OE is active-low. gpio-leds + ACTIVE_LOW means
	 * gpio_pin_set_dt(..., 1) drives the pin low (outputs enabled).
	 */
	pca9685_ctrl {
		compatible = "gpio-leds";

		pca9685_oe: pca9685_oe {
			gpios = <&gpio2 10 GPIO_ACTIVE_LOW>;
			label = "PCA9685 OE (P2.10)";
		};
	};

	rc_pwms {
		compatible = "pwm-leds";

		rc_pwm0: rc_pwm_0 {
			pwms = <&pca9685 0 PWM_USEC(20000)>;
			label = "RC PWM CH0 (PCA9685 LED0) LX";
		};

		rc_pwm1: rc_pwm_1 {
			pwms = <&pca9685 1 PWM_USEC(20000)>;
			label = "RC PWM CH1 (PCA9685 LED1) LY";
		};

		rc_pwm2: rc_pwm_2 {
			pwms = <&pca9685 2 PWM_USEC(20000)>;
			label = "RC PWM CH2 (PCA9685 LED2) RX";
		};

		rc_pwm3: rc_pwm_3 {
			pwms = <&pca9685 3 PWM_USEC(20000)>;
			label = "RC PWM CH3 (PCA9685 LED3) RY";
		};

		rc_pwm4: rc_pwm_4 {
			pwms = <&pca9685 4 PWM_USEC(20000)>;
			label = "RC PWM CH4 throttle RT (PCA9685 LED4)";
		};

		rc_pwm5: rc_pwm_5 {
			pwms = <&pca9685 5 PWM_USEC(20000)>;
			label = "RC PWM CH5 LT (PCA9685 LED5)";
		};

		rc_pwm6: rc_pwm_6 {
			pwms = <&pca9685 6 PWM_USEC(20000)>;
			label = "RC PWM CH6 AUX0 A (PCA9685 LED6)";
		};

		rc_pwm7: rc_pwm_7 {
			pwms = <&pca9685 7 PWM_USEC(20000)>;
			label = "RC PWM CH7 AUX1 B (PCA9685 LED7)";
		};

		rc_pwm8: rc_pwm_8 {
			pwms = <&pca9685 8 PWM_USEC(20000)>;
			label = "RC PWM CH8 drive RT+/LT- (PCA9685 LED8)";
		};
	};
};
