/ {
	chosen {
		nordic,pm-ext-flash = &mx25r64;
	};

	aliases {
		// Configure PWM module for led1 (LED2 on the board)
		pwm-led1 = &pwm_led1;

		// Use watchdog wdt31 as the application watchdog
		watchdog0 = &wdt31;
	};

	/* Relay control pins - same mote hardware as light_bulb_mote */
	zephyr,user {
		relay1-gpios = <&gpio1 9 GPIO_ACTIVE_LOW>;
		relay2-gpios = <&gpio2 10 GPIO_ACTIVE_LOW>;
	};

	pwmleds {
		compatible = "pwm-leds";
		pwm_led1: pwm_led_1 {
			pwms = <&pwm20 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
	};
};

// restore full RRAM and SRAM space - by default some parts are dedicated to FLRP
&cpuapp_rram {
	reg = <0x0 DT_SIZE_K(1524)>;
};

&cpuapp_sram {
	reg = <0x20000000 DT_SIZE_K(256)>;
	ranges = <0x0 0x20000000  0x40000>;
};

// TODO: re-enable HWFC once it's fixed
&uart20 {
	/delete-property/ hw-flow-control;
};

&mx25r64 {
	status = "okay";
};

&pwm20 {
	status = "okay";
	pinctrl-0 = <&pwm_default>;
	pinctrl-1 = <&pwm_sleep>;
	pinctrl-names = "default", "sleep";
};

&pinctrl {
	pwm_default: pwm_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT1, 1, 10)>;
		};
	};
	pwm_sleep: pwm_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT1, 1, 10)>;
			low-power-enable;
		};
	};
};

&wdt31 {
	status = "okay";
};

&clock {
	status = "okay";
};

&led0 {
	gpios = <&gpio1 5 GPIO_ACTIVE_LOW>;
};
&led1 {
	gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;
};
&led2 {
	status = "disabled";
};
&led3 {
	status = "disabled";
};

/*
 * Shared with light_bulb_mote: P1.08 = function / factory reset (DK_BTN1).
 * Switch-specific touch sensors:
 *   snr1 P1.12 -> button1 endpoint 1
 *   snr2 P1.11 -> button2 endpoint 2
 *   snr3 P0.02 -> button3 endpoint 3
 */
&button0 {
	gpios = <&gpio1 8 GPIO_ACTIVE_LOW>;
	label = "Factory reset";
	status = "okay";
};

&button1 {
	gpios = <&gpio1 12 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
	label = "Touch snr1";
	status = "okay";
};

&button2 {
	gpios = <&gpio1 11 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
	label = "Touch snr2";
	status = "okay";
};

&button3 {
	gpios = <&gpio0 2 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
	label = "Touch snr3";
	status = "okay";
};
